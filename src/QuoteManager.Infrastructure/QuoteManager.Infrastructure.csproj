<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\QuoteManager.Application\QuoteManager.Application.csproj" />
  </ItemGroup>

  <!-- ICurrentUser is implemented over HttpContext.User, which needs the ASP.NET Core
       abstractions. Infrastructure uses Microsoft.NET.Sdk rather than Sdk.Web, so the shared
       framework is pulled in via FrameworkReference rather than a NuGet package - the standalone
       Microsoft.AspNetCore.Http.Abstractions package is frozen at 2.2.0 and superseded by the
       shared framework for anything targeting modern ASP.NET Core. This framework reference also
       supersedes the explicit Hosting.Abstractions, Options.ConfigurationExtensions and
       Identity.Core package references that used to live below - NuGet's reference-pruning flags
       them as redundant (NU1510) once the framework already carries them. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <!-- The Azure adapter compiles into every build and is selected only when its
       connection string is present. It is never a conditional compilation symbol. -->
  <ItemGroup>
    <PackageReference Include="Azure.Messaging.ServiceBus" />
  </ItemGroup>

</Project>
